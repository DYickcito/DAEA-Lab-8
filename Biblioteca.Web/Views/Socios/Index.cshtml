@model IEnumerable<Socio>

@{
    ViewData["Title"] = "Listado de Socios";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2 mb-0 text-dark">
        <i class="bi bi-people me-2 text-primary"></i>Socios Activos
    </h1>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-person-plus me-1"></i>Nuevo Socio
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th>DNI</th>
                        <th>Nombre y Apellidos</th>
                        <th>Correo Electrónico</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var socio in Model)
                        {
                            <tr>
                                <td><span class="badge bg-secondary-subtle text-secondary-emphasis border">@socio.DNI</span></td>
                                <td class="fw-semibold">@socio.Nombre</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(socio.Email))
                                    {
                                        <a href="mailto:@socio.Email" class="text-decoration-none">
                                            <i class="bi bi-envelope me-1"></i>@socio.Email
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">No registrado</span>
                                    }
                                </td>
                                <td>
                                    @if (socio.Activo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactivo</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                <i class="bi bi-info-circle fs-4 d-block mb-2"></i>
                                No hay socios activos registrados en la base de datos.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
