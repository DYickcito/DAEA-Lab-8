@model Libro

@{
    ViewData["Title"] = "Eliminar Libro";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white py-3">
                <h4 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Confirmar Eliminación</h4>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-warning mb-4">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    ¿Está seguro de que desea eliminar este libro? Se realizará una <strong>eliminación lógica</strong> (el estado cambiará a inactivo y ya no aparecerá en el catálogo).
                </div>

                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">ID:</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.LibroId</dd>

                    <dt class="col-sm-4 text-muted">Título:</dt>
                    <dd class="col-sm-8 fw-bold fs-5 text-dark">@Model.Titulo</dd>

                    <dt class="col-sm-4 text-muted">ISBN:</dt>
                    <dd class="col-sm-8"><code>@Model.ISBN</code></dd>

                    <dt class="col-sm-4 text-muted">Autor:</dt>
                    <dd class="col-sm-8">@Model.AutorNombre</dd>

                    <dt class="col-sm-4 text-muted">Ejemplares:</dt>
                    <dd class="col-sm-8">@Model.Ejemplares</dd>
                </dl>

                <form asp-action="Delete" method="post" class="mt-4 pt-3 border-top d-flex justify-content-between">
                    <input type="hidden" asp-for="LibroId" />
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Cancelar y Volver
                    </a>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash-fill me-1"></i>Confirmar Eliminación
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
