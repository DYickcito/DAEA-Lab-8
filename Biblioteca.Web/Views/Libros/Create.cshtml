@model Libro

@{
    ViewData["Title"] = "Registrar Libro";
    var autores = (SelectList)ViewData["Autores"]!;
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0"><i class="bi bi-book me-2"></i>Registrar Nuevo Libro</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Titulo" class="form-label fw-semibold"></label>
                        <input asp-for="Titulo" class="form-control" placeholder="Ej: Cien años de soledad" />
                        <span asp-validation-for="Titulo" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ISBN" class="form-label fw-semibold"></label>
                        <input asp-for="ISBN" class="form-control" placeholder="Ej: 9780307474728" />
                        <span asp-validation-for="ISBN" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AutorId" class="form-label fw-semibold"></label>
                        <select asp-for="AutorId" asp-items="autores" class="form-select">
                            <option value="">-- Seleccione un autor --</option>
                        </select>
                        <span asp-validation-for="AutorId" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Ejemplares" class="form-label fw-semibold"></label>
                        <input asp-for="Ejemplares" type="number" min="0" class="form-control" />
                        <span asp-validation-for="Ejemplares" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between pt-2 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check2-circle me-1"></i>Guardar Libro
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
