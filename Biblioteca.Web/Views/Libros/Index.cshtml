@model IEnumerable<Libro>

@{
    ViewData["Title"] = "Catálogo de Libros";
    var busquedaActual = ViewData["TituloBusqueda"]?.ToString();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h2 mb-0 text-dark">
        <i class="bi bi-journal-album me-2 text-primary"></i>Catálogo de Libros
    </h1>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-circle me-1"></i>Nuevo Libro
    </a>
</div>

<!-- Barra de búsqueda por título -->
<div class="card shadow-sm mb-4 border-0">
    <div class="card-body bg-white rounded">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-9 col-sm-8">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="titulo" class="form-control" placeholder="Buscar libro por título..." value="@busquedaActual" />
                </div>
            </div>
            <div class="col-md-3 col-sm-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="bi bi-search me-1"></i>Buscar
                </button>
                @if (!string.IsNullOrWhiteSpace(busquedaActual))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Limpiar filtro">
                        <i class="bi bi-x-circle"></i> Limpiar
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Tabla de resultados -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th>Título</th>
                        <th>ISBN</th>
                        <th>Autor</th>
                        <th>Ejemplares</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var libro in Model)
                        {
                            @* Reutilización de la vista parcial para la fila *@
                            <partial name="_LibroRow" model="libro" />
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                <i class="bi bi-info-circle fs-4 d-block mb-2"></i>
                                No se encontraron libros registrados o que coincidan con la búsqueda.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
