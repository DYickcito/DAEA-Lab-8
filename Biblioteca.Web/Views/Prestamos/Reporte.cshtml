@model IEnumerable<PrestamoReporte>

@{
    ViewData["Title"] = "Reporte de Préstamos";
    var desde = ViewData["Desde"]?.ToString();
    var hasta = ViewData["Hasta"]?.ToString();
    bool tieneFiltro = !string.IsNullOrWhiteSpace(desde) || !string.IsNullOrWhiteSpace(hasta);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2 mb-0 text-dark">
        <i class="bi bi-file-earmark-bar-graph me-2 text-primary"></i>Reporte de Préstamos
    </h1>
</div>

<!-- Filtro por rango de fechas (enviado por GET) -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form asp-action="Reporte" method="get" class="row g-3 align-items-end">
            <div class="col-md-4 col-sm-6">
                <label for="desde" class="form-label fw-semibold">Fecha Desde:</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-calendar3"></i></span>
                    <input type="date" id="desde" name="desde" class="form-control" value="@desde" />
                </div>
            </div>

            <div class="col-md-4 col-sm-6">
                <label for="hasta" class="form-label fw-semibold">Fecha Hasta:</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-calendar3"></i></span>
                    <input type="date" id="hasta" name="hasta" class="form-control" value="@hasta" />
                </div>
            </div>

            <div class="col-md-4 col-sm-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="bi bi-funnel me-1"></i>Filtrar
                </button>
                @if (tieneFiltro)
                {
                    <a asp-action="Reporte" class="btn btn-outline-secondary" title="Limpiar rango de fechas">
                        <i class="bi bi-x-circle me-1"></i>Limpiar
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Tabla de resultados -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th>#</th>
                        <th>Socio</th>
                        <th>Libro Prestado</th>
                        <th>Fecha Préstamo</th>
                        <th>Fecha Límite</th>
                        <th>Fecha Devolución</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-muted small">@item.PrestamoId</td>
                                <td class="fw-semibold">@item.SocioNombre</td>
                                <td><i class="bi bi-book text-muted me-1"></i>@item.LibroTitulo</td>
                                <td>@item.FechaPrestamo.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (item.Estado == "Pendiente" && item.FechaLimite < DateTime.Today)
                                    {
                                        <span class="text-danger fw-semibold" title="Vencido">
                                            <i class="bi bi-clock-history me-1"></i>@item.FechaLimite.ToString("dd/MM/yyyy")
                                        </span>
                                    }
                                    else
                                    {
                                        <span>@item.FechaLimite.ToString("dd/MM/yyyy")</span>
                                    }
                                </td>
                                <td>
                                    @if (item.FechaDevolucion.HasValue)
                                    {
                                        <span>@item.FechaDevolucion.Value.ToString("dd/MM/yyyy")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Pendiente</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Estado == "Devuelto")
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Devuelto</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Pendiente</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-4 d-block mb-2"></i>
                                No se encontraron registros de préstamos para el intervalo seleccionado.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
